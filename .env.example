# Скопируйте в .env и при необходимости поменяйте.
POSTGRES_USER=compass
POSTGRES_PASSWORD=compass
POSTGRES_DB=compass

# Для запуска бэкенда без Docker (БД из docker compose на порту 5433)
DATABASE_URL=postgresql+psycopg://compass:compass@localhost:5433/compass

JWT_SECRET=dev-secret-change-me

# Пароль демо-аккаунтов doctor@example.com / patient@example.com (python -m app.seed)
SEED_PASSWORD=compass-demo-2026

# LLM (ml-service): любой OpenAI-совместимый сервер.
# Основной вариант — модель на V100 через JupyterHub (README → «Модель на V100 через JupyterHub»).
# Адрес и токен даёт Матвей; токен храним только здесь, в .env:
# LLM_BASE_URL=https://<адрес-JupyterHub>/user/<логин>/proxy/11435/v1
# LLM_BASE_URL_DOCKER=https://<адрес-JupyterHub>/user/<логин>/proxy/11435/v1
# LLM_API_KEY=<токен JupyterHub>
# LLM_MODEL=qwen2.5:14b
# Без JupyterHub — Ollama на своём компьютере или SSH-туннель к серверу (README → «Запасной вариант»).
# Модель должна быть скачана на том сервере, где работает Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Для GPU 4 ГБ (GTX 1650): LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
# Адрес модели для контейнера ml в docker compose (по умолчанию — порт 11434 на хосте)
# LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
