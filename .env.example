# Скопируйте в .env и при необходимости поменяйте.
POSTGRES_USER=compass
POSTGRES_PASSWORD=compass
POSTGRES_DB=compass

# Для запуска бэкенда без Docker (БД из docker compose на порту 5433)
DATABASE_URL=postgresql+psycopg://compass:compass@localhost:5433/compass

JWT_SECRET=dev-secret-change-me

# Проверка правил по расписанию («нет записей пациента 3 и 5 дней»), в минутах; 0 — выключить
# RULES_CHECK_MINUTES=60

# Пароль демо-аккаунтов doctor@example.com / patient@example.com (python -m app.seed)
SEED_PASSWORD=compass-demo-2026

# Языковая модель (ml-сервис): любой OpenAI-совместимый сервер; для первого запуска не нужна (README → «Языковая модель»).
# По умолчанию — Ollama на своём компьютере; модель должна быть скачана там, где работает Ollama.
# Модель на V100 через JupyterHub — ml/server/qwen_remote_v2/README.md; токен храним только здесь, в .env.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Для GPU 4 ГБ (GTX 1650): LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
# Адрес модели для контейнера ml в docker compose (по умолчанию — порт 11434 на хосте)
# LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# Резервные копии базы (сервис backup): интервал в секундах и сколько копий хранить
# BACKUP_INTERVAL_S=7200
# BACKUP_KEEP=24
